multfac:
    li      $t3,    1
    sll     $t3,    $t3,    31      # constante 2**31

    move    $s0,    $zero           # P[63-32] = 0
    move    $s1,    $a1             # P[31-0] = Q
    move    $s2,    $a0             # $s2 = M

    slt     $t4,    $s2,    $zero
    slt     $t5,    $s1,    $zero

    beq     $t4,    $zero,  ninvm   # if $t4 = 0, nao inverte M

    nor     $s2,    $s2,    $zero   # inverte M
    addi    $s2,    $s2,    1

ninvm:
    beq     $t5,    $zero,  ninvq   # if $t5 = 0, nao inverte Q

    nor     $s1,    $s1,    $zero   # inverte Q
    addi    $s1,    $s1,    1

ninvq:

    li      $t1,    0               # i = 0
for:
    slti    $t2,    $t1,    32
    beq     $t2,    $zero,  end     # If i >= 32, end

    andi    $t0,    $s1,    1
    beq     $t0,    $zero,  nsoma   # If P[0] = 0, nao soma

    add     $s0,    $s0,    $s2     # P[63-32] += M

nsoma:
    andi    $t0,    $s0,    1       # Valor de P[32]

    srl     $s0,    $s0,    1       # shift a direita de P
    srl     $s1,    $s1,    1

    beq     $t0,    $zero,  iter

    addu    $s1,    $s1,    $t3     # Se P[32] = 1, P[31] = 1

iter:
    addi    $t1,    $t1,    1       # i++
    j       for

end:
    bne     $t4,    $zero,  invp    # Se M < 0, inverte P
    bne     $t5,    $zero,  invp    # Se Q < 0, inverte P
    j       exit

invp:
    nor     $s1,    $s1,    $zero   # inverte P[31-0]
    nor     $s0,    $s0,    $zero   # inverte P[63-32]

    addiu   $s1,    $s1,    1       # Soma 1

# Detecta de havera carry para o outro reg
    nor     $t6,    $s1,    $zero
    sltiu   $t6,    $t6,    1
    bne     $t6,    $zero,  carry

    j       exit
carry:
    addi    $s0,    $s0,    1

exit:
    mthi    $s0                     # Salva P[63-32] em Hi
    mtlo    $s1                     # Salva P[31-0] em Lo
    jr      $ra
