.data
linha: .asciiz "\n"
of_msg: .asciiz "overflow\n"

.text
main:
    li      $v0,    5
    syscall 
    move    $s0,    $v0             # ler valor sinal

    li      $v0,    5
    syscall 
    move    $t1,    $v0             # ler n1

    li      $v0,    5
    syscall 
    move    $t2,    $v0             # ler n2

    addu    $t0,    $t1,    $t2     # n1 + n2

    beq     $s0,    $zero,  sem_sinal

# deteccao de overflow
sinal:
    xor     $t3,    $t1,    $t2
    slt     $t3,    $t3,    $zero
    bne     $t3,    $zero,  sem_of

    xor     $t3,    $t0,    $t1
    slt     $t3,    $t3,    $zero
    bne     $t3,    $zero,  of
    j sem_of

sem_sinal:
    nor     $t3,    $t1,    $zero
    sltu    $t3,    $t3,    $t2
    bne     $t3,    $zero,  of

sem_of:
    li      $v0,    1
    move    $a0,    $t0
    syscall 

    li      $v0,    4
    la      $a0,    linha
    syscall 

    li      $v0,    10
    syscall 

of:
    li      $v0,    4
    la      $a0,    of_msg
    syscall 

    li      $v0,    10
    syscall 
