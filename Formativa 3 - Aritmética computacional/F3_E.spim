.data
linha: .asciiz "\n"

.text
main:
    li      $v0,    6
    syscall 
    mov.s   $f1,    $f0             # ler custo de fabrica
    
    li      $v0,    6
    syscall 
    mov.s   $f2,    $f0             # ler taxa lucro

    li      $v0,    6
    syscall 
    mov.s   $f3,    $f0             # ler taxa imposto

    li.s    $f0,    100.0

    div.s   $f2,    $f2,    $f0     # transformando em porcentagem
    div.s   $f3,    $f3,    $f0     # transformando em porcentagem

    mov.s   $f4,    $f1             # resultado = custo de fabrica

    mul.s   $f5,    $f1,    $f2     # x = custo de fabrica * taxa de lucro 
    mul.s   $f6,    $f1,    $f3     # y = custo de fabrica * taxa de imposto

    add.s   $f4,    $f4,    $f5     # resultado += x
    add.s   $f4,    $f4,    $f6     # resultado += y

    li      $v0,    2
    mov.s   $f12,   $f4             # print resultado
    syscall 

    li      $v0,    4
    la      $a0,    linha
    syscall 

    li      $v0,    10
    syscall 
