.data
linha: .asciiz "\n"

.text
main:
    li      $v0,    7
    syscall 
    mov.d   $f2,    $f0             # ler custo de fabrica

    li      $v0,    7
    syscall 
    mov.d    $f4,    $f0            # ler taxa de lucro

    li      $v0,    7
    syscall 
    mov.d    $f6,    $f0            # ler taxa de imposto

    li.d    $f0,    100.0

    div.d   $f4,    $f4,    $f0     # transformando em porcentagem
    div.d   $f6,    $f6,    $f0     # transformando em porcentagem

    mov.d   $f8,    $f2             # resultado = custo de fabrica

    mul.d   $f10,    $f2,    $f4    # x = custo de fabrica * taxa de lucro
    mul.d   $f12,    $f2,    $f6    # y = custo de fabrica * taxa de imposto

    add.d   $f8,    $f8,    $f10    # resultado += x
    add.d   $f8,    $f8,    $f12    # resultado += y

    li      $v0,    3
    mov.d   $f12,   $f8             # print resultado
    syscall 

    li      $v0,    4
    la      $a0,    linha
    syscall 

    li      $v0,    10
    syscall 
