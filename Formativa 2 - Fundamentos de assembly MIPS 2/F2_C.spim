.data
linha: .asciiz "\n"
zero: .asciiz "0"
espaco: .asciiz " "

.text
main:
# add pilha
    addi    $sp,    $sp,    -4
    sw      $ra,    ($sp)

# le entrada
    li      $v0,    5
    syscall 

    sw      $v0,    ($sp)
    lw      $s0,    ($sp)

    li      $t2,    9                   # constante

    li      $t0,    1                   # i = 1
for1:
    slt     $v1,    $s0,    $t0         # se n < i, $v1 = 1
    bne     $v1,    $zero,  exitfor1    # se $v1 = 0, exit

    move    $t1,    $zero               # j = 0
for2:
    slt     $v1,    $t1,    $t0         # se j < i, $v1 = 1
    beq     $v1,    $zero,  exitfor2    # se $v1 = 0, exitfor2

    slt     $v1,    $t2,    $t0         # se 9 < i, $v1 = 1
    beq     $v1,    $zero,  else        # se $v1 = 0, else


    li      $v0,    1
    move    $a0,    $t0                 # print("i ")
    syscall 
    li      $v0,    4
    la      $a0,    espaco
    syscall 
    j       endif

else:
                                        # print("0i ")
    li      $v0,    4
    la      $a0,    zero
    syscall 
    li      $v0,    1
    move    $a0,    $t0
    syscall 
    li      $v0,    4
    la      $a0,    espaco
    syscall 

endif:
    addi    $t1,    $t1,    1           # j++
    j       for2

exitfor2:

    li      $v0,    4
    la      $a0,    linha               # print("\n")
    syscall 

    addi    $t0,    $t0,    1           # i++
    j       for1

exitfor1:

    li      $v0,    4
    la      $a0,    linha               # print("\n")
    syscall 

    li      $t0,    1                   # i = 1
for3:
    slt     $v1,    $s0,    $t0         # se n < i, $v1 = 1
    bne     $v1,    $zero,  exit        # se $v1 = 0, exit

    li      $t1,    1                   # j = 1
for4:
    slt     $v1,    $t0,    $t1         # se 1 < j, $v1 = 1
    bne     $v1,    $zero,  exitfor4    # se $v1 != 0, exitfor4

    slt     $v1,    $t2,    $t1         # se 9 < j, $v1 = 1
    beq     $v1,    $zero,  else2       # se $v1 = 0, else2

# print("j ")
    li      $v0,    1
    move    $a0,    $t1
    syscall 
    li      $v0,    4
    la      $a0,    espaco
    syscall 
    j       endif2

else2:

    li      $v0,    4
    la      $a0,    zero                # print("0j ")
    syscall 
    li      $v0,    1
    move    $a0,    $t1
    syscall 
    li      $v0,    4
    la      $a0,    espaco
    syscall 

endif2:
    addi    $t1,    $t1,    1           # j++
    j       for4

exitfor4:

    li      $v0,    4
    la      $a0,    linha               # print("\n")
    syscall 

    addi    $t0,    $t0,    1           # i++
    j       for3

exit:
    lw      $ra,    ($sp)
    addi    $sp,    $sp,    4
    li      $v0,    10
    syscall 